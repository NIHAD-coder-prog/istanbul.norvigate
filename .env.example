# Public address of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://istanbul.norvigate.com
SITE_DOMAIN=istanbul.norvigate.com

# Keep false until the founder approves launch (robots disallows everything and pages are noindex)
NORVIGATE_ALLOW_INDEXING=false

# Where form submissions are stored (inside the container; mapped to the nv-data volume)
NORVIGATE_DATA_DIR=/data

# Optional: a webhook (Slack/Discord/etc.) that receives "new request NV-… (kind, locale)" — never personal data
NORVIGATE_NOTIFY_WEBHOOK=

# Optional: point exchange rates at a mirror or test fixture (default: the Exchange Rate API open endpoint)
NORVIGATE_RATES_URL=

# Owner preview: open https://<site>/api/preview?key=<this value> to see every feature privately (visitors keep seeing the level set in content/_settings.json)
NORVIGATE_PREVIEW_KEY=
